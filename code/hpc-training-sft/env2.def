Bootstrap: docker
From: ubuntu:20.04

%post
	export DEBIAN_FRONTEND=noninteractive
	# install the desired software
	apt-get update
	apt-get install -y gnupg2 gcc gfortran python3 python3-pip build-essential software-properties-common wget ubuntu-drivers-common
	pip3 install --upgrade pip
	wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/x86_64/cuda-ubuntu2004.pin
	mv cuda-ubuntu2004.pin /etc/apt/preferences.d/cuda-repository-pin-600
	wget https://developer.download.nvidia.com/compute/cuda/12.1.0/local_installers/cuda-repo-ubuntu2004-12-1-local_12.1.0-530.30.02-1_amd64.deb
	dpkg -i cuda-repo-ubuntu2004-12-1-local_12.1.0-530.30.02-1_amd64.deb
	cp /var/cuda-repo-ubuntu2004-12-1-local/cuda-*-keyring.gpg /usr/share/keyrings/
	DEBIAN_FRONTEND="noninteractive" apt-get update
	DEBIAN_FRONTEND="noninteractive" apt-get install -y cuda
	wget https://developer.download.nvidia.com/compute/redist/cudnn/v8.8.0/local_installers/12.0/cudnn-local-repo-ubuntu2004-8.8.0.121_1.0-1_amd64.deb
	dpkg -i cudnn-local-repo-ubuntu2004-8.8.0.121_1.0-1_amd64.deb

	apt install build-essential
	apt-get install git

	pip3 install llama-cpp-python \
	  --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cu121
	pip3 install torch torchvision torchaudio
	pip3 install peft==0.7.1
	pip3 install transformers==4.43.1
	pip3 install vllm==0.5.3.post1
	pip3 install gguf==0.3.3
	pip3 install numpy==1.24.4
	pip3 install sentencepiece==0.1.98
	pip3 install bitsandbytes
	pip3 install datasets
	pip3 install safetensors
	pip3 install langchain
	pip3 install pandas
	pip3 install openpyxl
	pip3 install scikit-learn
	apt-get clean

%environment
	export LC_ALL=C
	export PATH=/usr/local/cuda/bin:$PATH
	export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH


